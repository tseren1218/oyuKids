# Copy to .env and fill in. Every variable is prefixed with OYU_.

# Signs the (mock) login cookie — set a long random value outside dev
OYU_SESSION_SECRET=

# Storage backend: "memory" (mock, default) or "singlestore"
OYU_DB_BACKEND=memory
# singlestoredb connection URL, e.g. user:password@host:3306/oyukids
OYU_SINGLESTORE_URL=

# Speech-to-text: "mock" (default) or "oyu" (Anir — https://dev.oyu.so, key from https://oyu.so/account/apikeys)
OYU_STT_PROVIDER=mock
OYU_STT_API_KEY=
OYU_STT_MODEL=
